  {
   "id": 2,
   "title": "API hits / min by route",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (http_route) (rate(agent_http_requests_total[1m])) * 60",
     "legendFormat": "{{http_route}}",
